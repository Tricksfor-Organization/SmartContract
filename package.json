{
  "name": "tricksfor-smartcontract",
  "version": "1.0.0",
  "description": "Tricksfor Booster NFT smart contracts (ERC-721 collection + staking)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "bin": {
    "generate-assets": "scripts/generate-nft-metadata.js"
  },
  "scripts": {
    "compile": "node scripts/sync-contract-artifacts.js",
    "artifacts:sync": "node scripts/sync-contract-artifacts.js",
    "artifacts:check": "node scripts/sync-contract-artifacts.js --check",
    "security:prepare": "node scripts/prepare-slither-build.js",
    "test": "npm run compile && hardhat test --no-compile",
    "test:coverage": "hardhat test --coverage",
    "clean": "hardhat clean",
    "generate-assets": "node scripts/generate-nft-metadata.js",
    "generate:manifest": "node scripts/generate-nft-manifest.js",
    "generate:assets": "node scripts/generate-nft-assets.js",
    "generate:metadata": "node scripts/generate-nft-metadata.js",
    "generate:sample": "node scripts/generate-nft-metadata.js --chain ethereum --theme coin --output nft-assets/sample --force",
    "validate:assets": "node scripts/validate-nft-assets.js",
    "validate:output": "node scripts/validate-nft-output.js",
    "test:snapshots": "node scripts/test-metadata-snapshots.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "3.0.7",
    "@openzeppelin/contracts": "5.6.1",
    "hardhat": "3.10.0",
    "solc": "0.8.26"
  }
}
